# LLM (Paytm inference gateway)
LLM_API_KEY=
LLM_BASE_URL=https://api.inference.paytm.com/v1
LLM_MODEL=al-agentic-gpt-oss-120b
# Used only when a screenshot (Snap) is attached; must support image input.
LLM_VISION_MODEL=al-gpt-5

# Speech-to-text (OpenAI-compatible /audio/transcriptions). Leave STT_URL empty to
# default to ${LLM_BASE_URL}/audio/transcriptions. If the gateway has no STT,
# voice capture shows an error and you can still type / paste into the panel.
STT_URL=
STT_MODEL=whisper-1
